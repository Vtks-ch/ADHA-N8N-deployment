# ADHA n8n environment runtime settings. Do NOT commit .env or secrets.
ENVIRONMENT="dev"
N8N_DOMAIN=""                    # e.g. n8n-dev.internal.adha.example
N8N_PROTOCOL="https"
N8N_LICENSE_KEY=""               # optional; preferred: populate Key Vault directly
LICENSE_ACTIVATED="false"
N8N_TIMEZONE="Asia/Kolkata"
CUSTOM_CA_CERT_PATH="./certs/internal-ca.pem"
# The Terraform stack creates ACR, Key Vault, PostgreSQL, Redis and Storage.
# deploy-adha.sh reads these from terraform outputs; no IDs/passwords are copied here.
