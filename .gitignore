# =============================================================================
# n8n Enterprise — gitignore
# =============================================================================

# --- Secrets / Certificates (NEVER commit these) ---
certs/
*.pem
*.key
*.crt
*.pfx
*.p12
n8n-encryption-key.backup.txt
n8n-db-app-password.backup.txt
postgres-admin-password.txt

# --- Rendered/working files (generated by deploy.sh from templates) ---
values-enterprise-rendered.yaml
azure/secret-provider-class-rendered.yaml

# --- Local Helm chart copy (fetched by deploy.sh) ---
n8n-hosting/
n8n-hosting.zip
n8n-hosting-main/

# --- IDE / OS junk ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# --- Per-environment config (NOT committed; each env supplies its own) ---
# .env holds environment-specific values (tenant ID, KV name, hosts).
# Commit .env.template instead; each environment keeps its own local .env.
.env
.env.dev
.env.uat
.env.prod

# ADHA secrets/state
.env
*.tfstate
*.tfstate.*
*.tfplan
*.backup.txt
terraform/backend.tf
terraform/.terraform/
terraform/.terraform.lock.hcl
environments/*/values-enterprise-rendered.yaml
certs/*.pem
certs/*.key
certs/*.pfx
